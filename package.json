{
  "name": "projeto-imobiliaria",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:client": "react-router dev",
    "dev:server": "node server/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:reset": "prisma db push --force-reset --accept-data-loss",
    "prestart:api": "prisma generate",
    "seed": "node server/seed.js",
    "start": "react-router-serve ./build/server/index.js",
    "start:api": "node server/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-router/node": "7.14.0",
    "@react-router/serve": "7.14.0",
    "axios": "^1.15.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "isbot": "^5.1.36",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.14.0",
    "swiper": "^12.1.4"
  },
  "devDependencies": {
    "@react-router/dev": "7.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3"
